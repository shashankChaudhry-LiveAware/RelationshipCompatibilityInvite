{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<inviteId>.*)"
        }
      ],
      "destination": "https://www.liveaware.in/compatibility?id=:inviteId",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "https://www.liveaware.in/compatibility",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "destination": "https://www.liveaware.in/compatibility",
      "permanent": false
    }
  ]
}
